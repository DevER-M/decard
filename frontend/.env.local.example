# Copy to .env.local and fill in your values.

# Pinata API JWT (used server-side for IPFS uploads)
PINATA_JWT=your_pinata_jwt

# Deployed Sepolia contract addresses (after running scripts/deploy.py)
NEXT_PUBLIC_GAME_CARD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: custom IPFS gateway used to display card images
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
