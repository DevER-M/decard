# Copy to .env.local and fill in your values.

# Pinata API JWT (used server-side for IPFS uploads when minting)
# Get one free at https://app.pinata.cloud -> API Keys -> New Key -> JWT
PINATA_JWT=your_pinata_jwt

# Deployed Sepolia contract addresses (after running scripts/deploy.py)
NEXT_PUBLIC_GAME_CARD_ADDRESS=0x68F2B471CCca503B131D5cDf4D2CC7eAE472AC3a
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0xFD484e1Bb85d39EcDce0C808fc7d8098803201F7

# Optional: WalletConnect Cloud project ID (needed for QR-code wallets like WalletConnect).
# Injected wallets (MetaMask) work without it — when unset, no WalletConnect
# connector is registered (avoids the "Origin not found on Allowlist" console error).
# Get one free at https://cloud.reown.com and add http://localhost:3000 to the
# project's Allowed Origins list, then set the value here and restart the dev server.
# NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Optional: custom JSON-RPC URL (defaults to Ethereum Sepolia publicnode.com).
# NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: custom IPFS gateway used to display card images
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/